# Email configuration for 6SeasonsOrganic backend
# Set these values to enable order emails via Gmail
#
# 1. Go to https://myaccount.google.com/apppasswords (with 2-step verification enabled)
# 2. Generate an App Password for 'Mail' and copy it here
# 3. Restart your backend after editing this file

OWNER_EMAIL=6seasonsorganic@gmail.com
EMAIL_USER=6seasonsorganic@gmail.com
EMAIL_PASS=your_app_password_here
